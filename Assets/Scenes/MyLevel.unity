        \u0440\u043E\u0437\u0432\u0435\u0440\u043D\u0435\u0442\u044C\u0441\u044F.
        \u041F\u0430\u043B\u0438\u0432\u043E \u0448\u043A\u043E\u0434\u0438\u0442\u044C,
        \u0430 \u0436\u043E\u0432\u0442\u0456 \u0441\u0442\u043E\u0440\u043E\u0436\u043E\u0432\u0456
        \u0448\u0432\u0438\u0434\u0448\u0456."
