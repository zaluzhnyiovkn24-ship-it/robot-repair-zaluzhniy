    <ui:VisualElement name="FixedCounter" picking-mode="Ignore" style="flex-grow: 0; position: absolute; top: 20px; right: 20px; width: 360px; height: 180px; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/UICounterBar.png?fileID=21300000&amp;guid=4bb9e5210d4bc484ab335c62e1e0ffd3&amp;type=3#UICounterBar&quot;); -unity-background-scale-mode: scale-to-fit;">
        <ui:Label text="Полагоджено 0 / 3" name="FixedCounterLabel" style="flex-grow: 1; font-size: 30px; -unity-text-align: middle-center; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;);" />
